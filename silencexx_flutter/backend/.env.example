# Obtain a Singapore API key from Alibaba Cloud Model Studio (not the Coding Plan).
QWEN_API_KEY=
QWEN_WORKSPACE_ID=
# Recommended: https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Without a workspace ID the legacy Singapore endpoint is used.
# QWEN_BASE_URL=
QWEN_MODEL=qwen-flash
QWEN_TIMEOUT_MS=45000
QWEN_MAX_OUTPUT_TOKENS=512
QWEN_MAX_INPUT_CHARS=24000
# USD per 1M tokens, Singapore International qwen-flash, checked 2026-10-07.
QWEN_INPUT_USD_PER_MILLION=0.05
QWEN_CACHED_INPUT_USD_PER_MILLION=0.01
QWEN_OUTPUT_USD_PER_MILLION=0.4
# Comma-separated verified account IDs allowed to view global usage.
AI_ADMIN_USER_IDS=

NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudmind
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat
REDIS_HOST=localhost
REDIS_PORT=6379
PYTHON_EXECUTABLE=python
MOCK_WHISPER=false
# Optional email delivery and moderation services
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GEMINI_API_KEY=
# OAuth audiences accepted by backend token verification (comma-separated)
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_BUNDLE_ID=com.silencexx.silencexx
# Optional country-specific contacts maintained by the service operator.
# Example: [{"name":"Local crisis resource","number":"...","country":"..."}]
CRISIS_RESOURCES_JSON=[]

# Required: unique random secret, at least 32 characters. Never commit its value.
# JWT_SECRET=
# Only set to your actual trusted reverse-proxy hop count.
TRUST_PROXY_HOPS=0
# For a database signed by a private CA, supply the PEM CA file.
# DB_SSL_CA_FILE=
