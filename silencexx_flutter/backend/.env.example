NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudmind
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat
REDIS_HOST=localhost
REDIS_PORT=6379
PYTHON_EXECUTABLE=python
MOCK_WHISPER=false
# Optional email delivery and moderation services
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GEMINI_API_KEY=
# OAuth audiences accepted by backend token verification (comma-separated)
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_BUNDLE_ID=com.silencexx.silencexx
# Optional country-specific contacts maintained by the service operator.
# Example: [{"name":"Local crisis resource","number":"...","country":"..."}]
CRISIS_RESOURCES_JSON=[]
