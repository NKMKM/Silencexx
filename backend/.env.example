# Obtain a Singapore API key from Alibaba Cloud Model Studio (not the Coding Plan).
QWEN_API_KEY=
QWEN_WORKSPACE_ID=
# Recommended: https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Without a workspace ID the legacy Singapore endpoint is used.
# QWEN_BASE_URL=
QWEN_MODEL=qwen-flash
QWEN_TIMEOUT_MS=45000
QWEN_MAX_OUTPUT_TOKENS=512
QWEN_MAX_INPUT_CHARS=24000
# USD per 1M tokens, Singapore International qwen-flash, checked 2026-10-07.
QWEN_INPUT_USD_PER_MILLION=0.05
QWEN_CACHED_INPUT_USD_PER_MILLION=0.01
QWEN_OUTPUT_USD_PER_MILLION=0.4
# Comma-separated verified account IDs allowed to view global usage.
AI_ADMIN_USER_IDS=


PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudmind
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OTP Configuration (for SMS verification)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth (if needed for web auth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth (if needed for iOS auth)
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_KEY_CONTENT=your_apple_key_content

# Required: unique random secret, at least 32 characters. Never commit its value.
# JWT_SECRET=
# Only set to your actual trusted reverse-proxy hop count.
TRUST_PROXY_HOPS=0
# For a database signed by a private CA, supply the PEM CA file.
# DB_SSL_CA_FILE=
