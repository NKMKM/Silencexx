{
  "name": "cloudmind-backend",
  "version": "1.0.0",
  "description": "CloudMind AI Backend with Qwen API and token accounting",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "dev:ngrok": "node start-with-ngrok.js",
    "update-ngrok": "node update-ngrok-url.js",
    "migrate": "node run-migration.js",
    "setup-db": "node setup-database.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test tests/*.test.js",
    "test:ai": "node --test tests/ai.test.js",
    "economics": "node scripts/economics.js",
    "usage:report": "node scripts/usage-report.js",
    "usage:recover": "node scripts/recover-ai-usage.js",
    "test:security": "node --test tests/security.test.js",
    "db:check": "node scripts/check-db.js"
